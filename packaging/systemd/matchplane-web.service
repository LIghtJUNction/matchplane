[Unit]
Description=MatchPlane Next.js web and Better Auth server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=matchplane-web
Group=matchplane-web
SupplementaryGroups=matchplane
EnvironmentFile=/etc/matchplane/matchplane.env
EnvironmentFile=/etc/matchplane/services/web.env
# Keep Better Auth's signing secret readable only by the web service account.
EnvironmentFile=-/etc/matchplane/secrets/web/better-auth.env
Environment=MATCHPLANE_ENVIRONMENT=production
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=4173
WorkingDirectory=/usr/share/matchplane/web
Environment=MATCHPLANE_WEB_NODE=/usr/local/bin/node
# The web BFF needs only the two administrator bearer files, not the payment invoice key or
# gateway contact-data key. The bootstrap/deployment flow mirrors these tokens into the web-only
# secret directory with matchplane-web ownership.
Environment=MATCHPLANE_PAYMENT_ADMIN_TOKEN_FILE=/etc/matchplane/secrets/web/payment-admin.token
Environment=MATCHPLANE_GATEWAY_ADMIN_TOKEN_FILE=/etc/matchplane/secrets/web/gateway-admin.token
ExecStart=/usr/bin/matchplane serve web
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Root-admin archive uploads are opaque staging bytes. Keep the rest of the host read-only.
ReadWritePaths=/var/lib/matchplane/subplatform-uploads
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
