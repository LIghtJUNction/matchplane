[Unit]
Description=MatchPlane Next.js web and Better Auth server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=matchplane-web
Group=matchplane-web
SupplementaryGroups=matchplane
EnvironmentFile=/etc/matchplane/matchplane.env
EnvironmentFile=/etc/matchplane/services/web.env
# Keep web-only provider and signing secrets readable only by the web service account.
EnvironmentFile=-/etc/matchplane/secrets/web/better-auth.env
EnvironmentFile=-/etc/matchplane/secrets/web/router-ai.env
# MATCHPLANE_ENVIRONMENT is intentionally supplied by the shared environment file.
# This unit is used for development/test and production profiles; hard-coding the
# value here would silently turn a test installation into a production safety profile.
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=4173
WorkingDirectory=/usr/share/matchplane/web
# Debian, Fedora, and Arch nodejs packages install the host binary here. The
# container image has its own /usr/local/bin/node setting; this unit runs the
# packaged standalone web release on the host and must not assume that layout.
Environment=MATCHPLANE_WEB_NODE=/usr/bin/node
# The web BFF needs only the two administrator bearer files, not the payment invoice key or
# gateway contact-data key. The bootstrap/deployment flow mirrors these tokens into the web-only
# secret directory with matchplane-web ownership.
Environment=MATCHPLANE_PAYMENT_ADMIN_TOKEN_FILE=/etc/matchplane/secrets/web/payment-admin.token
Environment=MATCHPLANE_GATEWAY_ADMIN_TOKEN_FILE=/etc/matchplane/secrets/web/gateway-admin.token
# The isolated builder callback is a shared value, but each service receives its own
# least-privilege copy: matchplane-web cannot read the builder user's secret directory.
Environment=MATCHPLANE_SUBPLATFORM_BUILDER_TOKEN_FILE=/etc/matchplane/secrets/web/builder.token
ExecStart=/usr/bin/matchplane serve web
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Keep uploads, hosted media, and the durable Web-managed router-state root writable. Router
# generations and credential slots remain below the protected root-email directory only.
ReadWritePaths=/var/lib/matchplane/subplatform-uploads /var/lib/matchplane/media /etc/matchplane/secrets/root-email
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
