[Unit]
Description=MatchPlane deterministic matcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=matchplane
Group=matchplane
EnvironmentFile=/etc/matchplane/matchplane.env
EnvironmentFile=/etc/matchplane/services/matcher.env
ExecStart=/usr/bin/matchplane-matcher
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
