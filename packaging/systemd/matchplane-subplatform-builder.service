[Unit]
Description=MatchPlane isolated static subplatform builder
After=network-online.target matchplane-web.service
Wants=network-online.target
# The builder is optional until an operator supplies its isolated token and environment.  Do not
# let systemd turn an intentionally unconfigured capability into a restart storm.
ConditionPathExists=/etc/matchplane/services/subplatform-builder.env
ConditionPathExists=/etc/matchplane/secrets/builder/builder.token

[Service]
Type=simple
User=matchplane-builder
Group=matchplane-builder
# The builder needs to traverse the shared secret root (group `matchplane`) and
# read only the web-owned upload mount (group `matchplane-web`).  Its own token
# remains protected by the `matchplane-builder` group on the leaf file.
SupplementaryGroups=matchplane matchplane-web
EnvironmentFile=/etc/matchplane/matchplane.env
EnvironmentFile=/etc/matchplane/services/subplatform-builder.env
Environment=MATCHPLANE_SUBPLATFORM_BUILDER_TOKEN_FILE=/etc/matchplane/secrets/builder/builder.token
ExecStart=/usr/bin/matchplane serve subplatform-builder
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/matchplane/subplatform-artifacts /var/lib/matchplane/subplatform-builder-work
ReadOnlyPaths=/var/lib/matchplane/subplatform-uploads
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
