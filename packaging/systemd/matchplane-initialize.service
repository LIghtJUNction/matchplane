[Unit]
Description=Initialize MatchPlane PostgreSQL schema
After=network-online.target
Wants=network-online.target
Before=matchplane-gateway.service matchplane-payment-service.service matchplane-event-relay.service matchplane-matcher.service

[Service]
Type=oneshot
User=matchplane
Group=matchplane
EnvironmentFile=/etc/matchplane/matchplane.env
ExecStart=/usr/bin/xtask initialize
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
