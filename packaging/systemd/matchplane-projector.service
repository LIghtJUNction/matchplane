[Unit]
Description=MatchPlane Valkey projector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=matchplane-projector
Group=matchplane-projector
SupplementaryGroups=matchplane
EnvironmentFile=/etc/matchplane/matchplane.env
EnvironmentFile=/etc/matchplane/services/projector.env
ExecStart=/usr/bin/matchplane-projector
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
