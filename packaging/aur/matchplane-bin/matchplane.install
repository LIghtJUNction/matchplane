post_install() {
  systemd-sysusers matchplane.conf
  systemd-tmpfiles --create matchplane.conf
  /usr/sbin/matchplane-postgres-backup-prepare --if-postgres-present
  systemctl daemon-reload
  printf '%s\n' 'Configure /etc/matchplane/matchplane.env and /etc/matchplane/services/*.env before enabling services.'
  printf '%s\n' 'The PostgreSQL backup timer is installed disabled; production operators must enable it explicitly.'
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl disable --now matchplane-postgres-backup.timer || true
}

post_remove() {
  systemctl daemon-reload
}
