# Configure credentials before enabling MatchPlane services.
MATCHPLANE_ENVIRONMENT=production
# Replace with a unique UUID for this production node before enabling services.
MATCHPLANE_NODE_ID=REPLACE_WITH_UNIQUE_UUID
MATCHPLANE_GRPC_ADDR=0.0.0.0:50051
# Database and Valkey URLs are intentionally absent from this shared file.
# Put each workload's least-privilege URL in /etc/matchplane/services/*.env.
MATCHPLANE_KAFKA_BROKERS=127.0.0.1:9092
MATCHPLANE_KAFKA_SECURITY_PROTOCOL=SSL
MATCHPLANE_KAFKA_SSL_CA_LOCATION=/etc/matchplane/kafka/ca.crt
MATCHPLANE_KAFKA_SSL_CERTIFICATE_LOCATION=/etc/matchplane/kafka/client.crt
MATCHPLANE_KAFKA_SSL_KEY_LOCATION=/etc/matchplane/kafka/client.key
# MATCHPLANE_VALKEY_URL is workload-specific; see /etc/matchplane/services/*.env.
MATCHPLANE_LOG_FILTER=info,matchplane=info
MATCHPLANE_OTLP_ENDPOINT=https://127.0.0.1:4317
MATCHPLANE_REQUIRE_TLS=true
MATCHPLANE_TLS_CERTIFICATE_PATH=/etc/matchplane/tls/server.crt
MATCHPLANE_TLS_PRIVATE_KEY_PATH=/etc/matchplane/tls/server.key
MATCHPLANE_TLS_CLIENT_CA_PATH=/etc/matchplane/tls/client-ca.crt
# Create these as 32-byte raw, 64-character hex, or base64 keys with mode 0640 root:matchplane.
MATCHPLANE_CONTACT_DATA_KEY_FILE=/etc/matchplane/secrets/gateway/contact-data.key
MATCHPLANE_CONTACT_DATA_KEY_VERSION=1
MATCHPLANE_INVOICE_DATA_KEY_FILE=/etc/matchplane/secrets/payment/invoice-data.key
MATCHPLANE_INVOICE_DATA_KEY_VERSION=1
# Use a random administrator bearer token of at least 24 bytes.
MATCHPLANE_PAYMENT_ADMIN_TOKEN_FILE=/etc/matchplane/secrets/payment/payment-admin.token
MATCHPLANE_GATEWAY_ADMIN_TOKEN_FILE=/etc/matchplane/secrets/gateway/gateway-admin.token
# Platform-owned HTTPS origin used for payment provider return/notification URLs.
MATCHPLANE_PAYMENT_CALLBACK_ORIGIN=https://payments.example.com
# Root tenant used to scope recursive platform-chat delegation. Set this to the
# deployment's tenant UUID; leaving it empty disables cross-platform fan-out.
MATCHPLANE_ROOT_TENANT_ID=REPLACE_WITH_ROOT_TENANT_UUID
# Optional server-side Agent router. The platform pays token costs; keep the key out of browser env.
MATCHPLANE_ROUTER_AI_URL=
MATCHPLANE_ROUTER_AI_KEY=
MATCHPLANE_ROUTER_AI_MODEL=
MATCHPLANE_ROUTER_AI_MAX_TOKENS=512
MATCHPLANE_ROUTER_AI_REQUESTS_PER_HOUR=120
# Next standalone web service / Better Auth. Generate a unique secret with
# `openssl rand -base64 32`; never commit the real value.
BETTER_AUTH_URL=https://matx.tech
BETTER_AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_32_BYTE_SECRET
# Optional comma-separated origins for explicitly configured additional front ends.
BETTER_AUTH_TRUSTED_ORIGINS=
# Set the root superadmin email before the first account is created. The example
# value is intentionally rejected when NODE_ENV=production.
MATCHPLANE_ROOT_ADMIN_EMAIL=admin@example.com
MATCHPLANE_GATEWAY_INTERNAL_URL=http://127.0.0.1:8080
MATCHPLANE_PAYMENT_INTERNAL_URL=http://127.0.0.1:8081
