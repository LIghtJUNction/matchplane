# Development-only values. Production mode rejects default credentials and plaintext endpoints.
MATCHPLANE_ENVIRONMENT=development
MATCHPLANE_NODE_ID=00000000-0000-7000-8000-00000000000a
MATCHPLANE_HTTP_ADDR=0.0.0.0:8080
MATCHPLANE_GRPC_ADDR=0.0.0.0:50051
MATCHPLANE_POSTGRES_USER=matchplane
MATCHPLANE_POSTGRES_PASSWORD=matchplane_dev_only
MATCHPLANE_POSTGRES_DB=matchplane
MATCHPLANE_DATABASE_URL=postgres://matchplane:matchplane_dev_only@localhost:5432/matchplane
MATCHPLANE_KAFKA_BROKERS=localhost:9092
MATCHPLANE_VALKEY_PASSWORD=matchplane_dev_only
MATCHPLANE_VALKEY_URL=redis://:matchplane_dev_only@localhost:6379/
MATCHPLANE_LOG_FILTER=info,matchplane=debug
MATCHPLANE_OTLP_ENDPOINT=http://localhost:4317
MATCHPLANE_REQUIRE_TLS=false
MATCHPLANE_TLS_CERTIFICATE_PATH=
MATCHPLANE_TLS_PRIVATE_KEY_PATH=
MATCHPLANE_TLS_CLIENT_CA_PATH=
MATCHPLANE_PAYMENT_CALLBACK_ORIGIN=
MATCHPLANE_ROOT_TENANT_ID=00000000-0000-7000-8000-000000000100
# Optional host-local static plugin artifact root. Builders must stage immutable releases here.
MATCHPLANE_SUBPLATFORM_ARTIFACT_ROOT=
# Optional server-side Agent router. The platform pays the token cost; never expose this key as NEXT_PUBLIC_*.
MATCHPLANE_ROUTER_AI_URL=
MATCHPLANE_ROUTER_AI_KEY=
MATCHPLANE_ROUTER_AI_MODEL=
MATCHPLANE_ROUTER_AI_MAX_TOKENS=512
MATCHPLANE_ROUTER_AI_REQUESTS_PER_HOUR=120
MATCHPLANE_GATEWAY_HOST_PORT=8080
MATCHPLANE_PAYMENT_HOST_PORT=8081
MATCHPLANE_FEDERATION_HOST_PORT=50051
MATCHPLANE_WEB_HOST_PORT=4173
# Development-only Better Auth values. Production must use a unique HTTPS origin,
# a high-entropy secret, and an operator-owned root administrator address.
BETTER_AUTH_URL=http://localhost:4173
BETTER_AUTH_SECRET=matchplane_dev_only_auth_secret_change_in_production
MATCHPLANE_ROOT_ADMIN_EMAIL=admin@example.com
# Optional domestic social login. Each provider stays disabled until all five values are set.
# MATCHPLANE_WECHAT_OAUTH_CLIENT_ID=
# MATCHPLANE_WECHAT_OAUTH_CLIENT_SECRET=
# MATCHPLANE_WECHAT_OAUTH_AUTHORIZATION_URL=https://example.invalid/oauth/authorize
# MATCHPLANE_WECHAT_OAUTH_TOKEN_URL=https://example.invalid/oauth/token
# MATCHPLANE_WECHAT_OAUTH_USERINFO_URL=https://example.invalid/oauth/userinfo
# MATCHPLANE_WECHAT_OAUTH_SCOPES=openid,profile,email
# Repeat the same *_OAUTH_* variables for QQ and ALIPAY. Secrets are server-only.
# Optional build-time Alpine package mirror. Empty keeps Alpine's official CDN.
MATCHPLANE_ALPINE_MIRROR=
# Development uses deterministic in-process contact/invoice keys and an admin token.
# Production must configure the *_FILE variables documented in packaging/config/matchplane.env.
