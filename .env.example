# Development-only values. Production mode rejects default credentials and plaintext endpoints.
MATCHPLANE_ENVIRONMENT=development
# Development/test only. Local Compose defaults this to true so the first account can inspect the
# workspace without SMTP; production always requires the configured authentication flow.
# Local Compose defaults this to true so the first account can inspect the admin workspace without
# SMTP. Set false whenever this file is used outside a private development machine.
MATCHPLANE_ALLOW_DEMO_BOOTSTRAP=true
MATCHPLANE_ENABLE_LEGACY_MARKETPLACE_ADAPTER=false
MATCHPLANE_NODE_ID=00000000-0000-7000-8000-00000000000a
MATCHPLANE_HTTP_ADDR=0.0.0.0:8080
MATCHPLANE_GRPC_ADDR=0.0.0.0:50051
MATCHPLANE_POSTGRES_USER=matchplane
MATCHPLANE_POSTGRES_PASSWORD=matchplane_dev_only
MATCHPLANE_POSTGRES_DB=matchplane
MATCHPLANE_DATABASE_URL=postgres://matchplane:matchplane_dev_only@localhost:5432/matchplane
MATCHPLANE_KAFKA_BROKERS=localhost:9092
MATCHPLANE_VALKEY_PASSWORD=matchplane_dev_only
MATCHPLANE_VALKEY_URL=redis://:matchplane_dev_only@localhost:6379/
MATCHPLANE_LOG_FILTER=info,matchplane=debug
MATCHPLANE_OTLP_ENDPOINT=http://localhost:4317
MATCHPLANE_REQUIRE_TLS=false
MATCHPLANE_TLS_CERTIFICATE_PATH=
MATCHPLANE_TLS_PRIVATE_KEY_PATH=
MATCHPLANE_TLS_CLIENT_CA_PATH=
MATCHPLANE_PAYMENT_CALLBACK_ORIGIN=
# Empty means an uninitialized root platform. Set this to the tenant UUID created by the
# operator or a registered subplatform; the core never invents a tenant or catalogue.
MATCHPLANE_ROOT_TENANT_ID=
# Optional Better Auth organization UUID pin for root-scoped API keys. If empty, the web control
# plane resolves the organization explicitly marked rootPlatform for this tenant; it never
# infers the root path from a child package or a vehicle/catalogue record.
MATCHPLANE_ROOT_PLATFORM_ORGANIZATION_ID=
# Optional host-local static plugin artifact root. Builders must stage immutable releases here.
MATCHPLANE_SUBPLATFORM_ARTIFACT_ROOT=
# Writable upload staging root for root-admin archive registration; uploads are never extracted by web.
MATCHPLANE_SUBPLATFORM_UPLOAD_ROOT=
# Browser/Agent media relay default is 25 MiB. The route accepts up to 256 MiB;
# keep the reverse proxy unbounded for this exact path so this application limit applies.
MATCHPLANE_MEDIA_MAX_BYTES=26214400
MATCHPLANE_HOSTED_MEDIA_ROOT=
# Callback credential shared only by the web boundary and an isolated builder worker. Replace
# this development placeholder before enabling any non-development deployment.
MATCHPLANE_SUBPLATFORM_BUILDER_TOKEN=matchplane-development-builder
# Internal builder callback URL and limits. The Compose builder uses the service name; production
# should set a private HTTPS URL or service DNS and keep the token in a secret/file reference.
MATCHPLANE_SUBPLATFORM_BUILDER_WEB_URL=http://web:4173
MATCHPLANE_SUBPLATFORM_BUILDER_POLL_SECONDS=5
MATCHPLANE_SUBPLATFORM_BUILDER_BUILD_SECONDS=900
MATCHPLANE_SUBPLATFORM_GIT_ALLOWED_HOSTS=github.com,gitlab.com
# Optional server-side Agent router. rootSuperAdmin WebUI managed config is the preferred
# production injection path and overrides these ops/fallback values. Never expose a provider key
# as NEXT_PUBLIC_*. AI-ready requires one known protocol (openai-compatible,
# anthropic-messages, or gemini-generate-content), a nonempty model ID, a safe HTTPS API base,
# and a configured credential. Model IDs are copied manually from provider documentation and use
# the bounded ASCII identifier grammar documented in docs/ai-provider-contract.md.
MATCHPLANE_ROUTER_AI_URL=
MATCHPLANE_ROUTER_AI_KEY=
MATCHPLANE_ROUTER_AI_MODEL=
MATCHPLANE_ROUTER_AI_PROTOCOL=openai-compatible
# Optional comma-separated exact HTTPS origins. Entries cannot contain a path, query, fragment,
# or userinfo. Empty/unset permits any public HTTPS origin; runtime DNS safety still applies.
# Example: https://api.anthropic.com,https://generativelanguage.googleapis.com
MATCHPLANE_ROUTER_AI_ALLOWED_ORIGINS=
# When true, doctor is non-zero while effective AI is disabled/misconfigured. The web process still
# starts so rootSuperAdmin can stage, test, and atomically activate a managed configuration.
MATCHPLANE_ROUTER_AI_REQUIRED=false
MATCHPLANE_ROUTER_AI_PREFLIGHT_TIMEOUT_MS=20000
MATCHPLANE_ROUTER_AI_PREFLIGHT_BUDGET_MS=4000
MATCHPLANE_ROUTER_AI_MAX_TOKENS=512
MATCHPLANE_ROUTER_AI_TOOL_MODE=auto
MATCHPLANE_ROUTER_AI_MAX_STEPS=8
MATCHPLANE_ROUTER_AI_MAX_FANOUT=4
MATCHPLANE_ROUTER_FALLBACK_CHILDREN=4
# Total wall-clock budget for one recursive routing request (4s per hop remains the provider cap).
MATCHPLANE_ROUTER_AI_TOTAL_TIMEOUT_MS=20000
MATCHPLANE_ROUTER_AI_REQUESTS_PER_HOUR=120
MATCHPLANE_ROUTER_AI_GLOBAL_REQUESTS_PER_HOUR=120
# Optional child-owned MCP endpoints. Keys match a manifest agent.mcpServerKey (or child slug).
# The endpoint URL is operator-owned; credentials are referenced by tokenEnv and remain server-only.
# Production requires HTTPS and rejects private IP literals. Example for an independently
# deployed synthetic store Agent (the core Compose deliberately bundles no store Agents):
# MATCHPLANE_SUBPLATFORM_MCP_ENDPOINTS_JSON={"store-a":{"url":"https://store-a-agent.example/mcp","tokenEnv":"MATCHPLANE_STORE_A_MCP_TOKEN"}}
# MATCHPLANE_STORE_A_MCP_TOKEN=
MATCHPLANE_SUBPLATFORM_MCP_ENDPOINTS_JSON=
MATCHPLANE_SUBPLATFORM_MCP_TIMEOUT_MS=8000
# Optional HTTPS endpoint for manual rate sync. Responses must include an explicit USD base and
# provider effective date: { base: "USD", date: "YYYY-MM-DD", rates: { "CNY": 7.2 } }.
MATCHPLANE_EXCHANGE_RATE_URL=https://api.frankfurter.app/latest
# Development-only internal gateway token used by the web session bridge. Production must use
# MATCHPLANE_GATEWAY_ADMIN_TOKEN_FILE with a secret readable by the web service account.
MATCHPLANE_GATEWAY_ADMIN_TOKEN=matchplane-development-gateway-admin
MATCHPLANE_GATEWAY_HOST_PORT=8080
MATCHPLANE_PAYMENT_HOST_PORT=8081
MATCHPLANE_FEDERATION_HOST_PORT=50051
MATCHPLANE_WEB_HOST_PORT=4173
# Development-only Better Auth values. Compose derives BETTER_AUTH_URL from
# MATCHPLANE_WEB_HOST_PORT when this is left unset, so custom ports remain usable.
# Production must set a unique HTTPS origin, high-entropy secret, and operator-owned root address.
# BETTER_AUTH_URL=http://localhost:4173
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
BETTER_AUTH_SECRET=matchplane_dev_only_auth_secret_change_in_production
MATCHPLANE_OIDC_ENABLED=true
# Operator-owned address that may be promoted to rootSuperAdmin after Better Auth verification.
# Leave unset until the operator chooses the first administrator.
MATCHPLANE_ROOT_ADMIN_EMAIL=
# Contact exchange uses only Better Auth email/phone bindings verified by the root account.
# Packages and operators cannot define manual contact-entry fields.
# Optional development SMTP route. Production must use a web-only env/file secret reference,
# never a plaintext password in this file.
# MATCHPLANE_ROOT_SMTP_PROVIDER_KEY=root-smtp
# MATCHPLANE_ROOT_SMTP_HOST=smtp.example.com
# MATCHPLANE_ROOT_SMTP_PORT=587
# MATCHPLANE_ROOT_SMTP_TLS_MODE=starttls
# MATCHPLANE_ROOT_SMTP_USERNAME=no-reply@example.com
# MATCHPLANE_ROOT_SMTP_CREDENTIAL_SECRET_REF=env://MATCHPLANE_ROOT_SMTP_PASSWORD
# MATCHPLANE_ROOT_SMTP_FROM_ADDRESS=no-reply@example.com
# MATCHPLANE_ROOT_SMTP_MODE=test
# MATCHPLANE_ROOT_SMTP_ENABLED=true
# Optional phone OTP gateway. The endpoint receives { phoneNumber, code, purpose } and must
# be an operator-owned HTTPS service (localhost HTTP is accepted only in development).
# MATCHPLANE_SMS_PROVIDER_URL=https://sms.example.com/matchplane/send
# MATCHPLANE_SMS_PROVIDER_TOKEN=
# Optional OAuth login. Fallback providers stay disabled until their complete
# endpoint set is present; national identity accepts discovery or its complete
# endpoint set.
# The national network identity provider is shown as the preferred domestic
# login only after its official application-access contract or approved gateway
# is configured. It is voluntary; email/phone/password, Passkey and the other
# providers remain available as fallback methods.
# Configure either DISCOVERY_URL or the complete AUTHORIZATION/TOKEN/USERINFO
# endpoint set supplied by the official service/authorized gateway. Do not copy
# endpoints from an example or put private keys in this file.
# MATCHPLANE_NATIONAL_IDENTITY_OAUTH_CLIENT_ID=
# MATCHPLANE_NATIONAL_IDENTITY_OAUTH_CLIENT_SECRET=
# MATCHPLANE_NATIONAL_IDENTITY_OAUTH_DISCOVERY_URL=
# MATCHPLANE_NATIONAL_IDENTITY_OAUTH_AUTHORIZATION_URL=
# MATCHPLANE_NATIONAL_IDENTITY_OAUTH_TOKEN_URL=
# MATCHPLANE_NATIONAL_IDENTITY_OAUTH_USERINFO_URL=
# MATCHPLANE_NATIONAL_IDENTITY_OAUTH_SCOPES=openid
# Google uses the same generic OAuth contract as the domestic fallback providers below.
# MATCHPLANE_GOOGLE_OAUTH_CLIENT_ID=
# MATCHPLANE_GOOGLE_OAUTH_CLIENT_SECRET=
# MATCHPLANE_GOOGLE_OAUTH_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
# MATCHPLANE_GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
# MATCHPLANE_GOOGLE_OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
# MATCHPLANE_GOOGLE_OAUTH_SCOPES=openid,profile,email
# MATCHPLANE_WECHAT_OAUTH_CLIENT_ID=
# MATCHPLANE_WECHAT_OAUTH_CLIENT_SECRET=
# MATCHPLANE_WECHAT_OAUTH_AUTHORIZATION_URL=https://example.invalid/oauth/authorize
# MATCHPLANE_WECHAT_OAUTH_TOKEN_URL=https://example.invalid/oauth/token
# MATCHPLANE_WECHAT_OAUTH_USERINFO_URL=https://example.invalid/oauth/userinfo
# MATCHPLANE_WECHAT_OAUTH_SCOPES=snsapi_login
# Repeat the same *_OAUTH_* variables for QQ and ALIPAY. Secrets are server-only.
# Optional build-time Alpine package mirror. Empty keeps Alpine's official CDN.
MATCHPLANE_ALPINE_MIRROR=
# Development uses deterministic in-process contact/invoice keys and an admin token.
# Production must configure the *_FILE variables documented in packaging/config/matchplane.env.
