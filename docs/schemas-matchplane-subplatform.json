{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matchplane.dev/schemas/subplatform/v1.json",
  "title": "MatchPlane 子平台清单",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "id", "slug", "displayName", "rootApiVersion", "entry", "routes", "capabilities", "requiredScopes", "assets"],
  "properties": {
    "apiVersion": { "const": "matchplane.subplatform/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "slug": { "type": "string", "pattern": "^(?!root$)[a-z0-9][a-z0-9-]{1,62}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 2000 },
    "marketplaceContract": {
      "enum": ["generic-v1", "legacy-v1"],
      "default": "generic-v1",
      "description": "稳定的市场契约传输。若使用领域中立契约可省略；legacy-v1 仅为显式的兼容适配器。"
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["fixed", "range", "negotiable", "none"] },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "currencyScale": { "type": "integer", "minimum": 0, "maximum": 18 },
        "label": { "type": "string", "maxLength": 120 }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "fixed" } } },
          "then": { "required": ["currency"] }
        },
        {
          "if": { "properties": { "mode": { "const": "none" } } },
          "then": { "not": { "required": ["currencyScale"] } }
        }
      ]
    },
    "email": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providerKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,99}$" },
        "fromAddress": { "type": "string", "format": "email", "maxLength": 320 }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chat": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 500 },
          "properties": {
            "buyerHeadlines": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
            "demandDiscoveryDefault": { "type": "boolean", "default": false, "description": "Initial checkbox state for anonymous supply-side demand discovery; keep false unless the platform has separately collected consent." },
            "sellerHeadlines": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 160 } }
          },
          "maxProperties": 64
        },
        "copy": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 500 }, "maxProperties": 128 },
        "filters": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label", "source"],
            "properties": {
              "key": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$" },
              "label": { "type": "string", "minLength": 1, "maxLength": 200 },
              "source": { "enum": ["trust", "price", "attribute"] },
              "attribute": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$" },
              "value": { "type": "string", "maxLength": 200 }
            }
          }
        },
        "supplyFields": {
          "type": "array",
          "description": "Store-package-owned public catalog attribute fields. Never use for private records, canonical price/inventory/media, contact data, sensitive identifiers, costs, profit, storage location, or internal notes.",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label"],
            "properties": {
              "key": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$" },
              "label": { "type": "string", "minLength": 1, "maxLength": 200 },
              "type": { "enum": ["text", "textarea", "number", "url", "date", "select"] },
              "required": { "type": "boolean" },
              "placeholder": { "type": "string", "maxLength": 500 },
              "group": { "type": "string", "minLength": 1, "maxLength": 120 },
              "help": { "type": "string", "minLength": 1, "maxLength": 500 },
              "unit": { "type": "string", "minLength": 1, "maxLength": 40 },
              "min": { "type": "number", "minimum": -1000000000000000, "maximum": 1000000000000000 },
              "max": { "type": "number", "minimum": -1000000000000000, "maximum": 1000000000000000 },
              "step": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000000000000 },
              "options": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
            },
            "allOf": [
              {
                "if": { "required": ["options"] },
                "then": { "properties": { "type": { "const": "select" } }, "required": ["type"] }
              },
              {
                "if": { "properties": { "type": { "const": "select" } }, "required": ["type"] },
                "then": { "required": ["options"] }
              },
              {
                "if": { "anyOf": [{ "required": ["min"] }, { "required": ["max"] }, { "required": ["step"] }] },
                "then": { "properties": { "type": { "const": "number" } }, "required": ["type"] }
              }
            ]
          }
        }
      }
    },
    "rootApiVersion": { "const": "v1" },
    "entry": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$" },
    "routes": { "type": "array", "minItems": 1, "description": "第一条路由必须是 /slug；后续可选的后代路径写在后续条目。", "items": { "type": "string", "pattern": "^/[a-z0-9][a-z0-9-]*(?:/.*)?$" } },
    "capabilities": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_:-]+$" }, "uniqueItems": true },
    "requiredScopes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_:-]+$" }, "uniqueItems": true },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "owner"],
      "properties": {
        "protocol": { "const": "matchplane.retrieval/v1" },
        "owner": { "const": "subplatform" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "stages", "skills", "mcpTools"],
      "properties": {
        "protocol": { "const": "matchplane.agent/v1" },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "description": "Domain-owned stage taxonomy. Values are opaque to the root and may describe any vertical.",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$" }
        },
        "skills": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$" }
        },
        "mcpTools": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$" }
        },
        "mcpServerKey": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
          "description": "稳定的运营侧 key；该 key 将在包清单外映射到 MCP 终端。"
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["staticDirectory", "buildCommand"],
      "properties": {
        "staticDirectory": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$" },
        "buildCommand": { "type": "string", "maxLength": 500 },
        "dependencyPolicy": {
          "enum": ["locked", "latest"],
          "default": "locked",
          "description": "latest is an explicit Bun-only opt-in; it resolves package.json tags on each build and must not be used when reproducibility is required."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "dependencyPolicy": { "const": "latest" } } },
          "then": { "properties": { "buildCommand": { "const": "bun run build" } } }
        }
      ]
    }
  }
}
