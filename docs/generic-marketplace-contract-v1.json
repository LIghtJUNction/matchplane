{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matchplane.dev/schemas/generic-marketplace-contract-v1.json",
  "title": "MatchPlane domain-neutral marketplace contract v1",
  "description": "The root persists bounded intent, offer and consent-gated introduction records. Vertical attributes and terms remain opaque JSON objects.",
  "version": "v1",
  "resources": {
    "participant": {
      "create": {
        "method": "POST",
        "path": "/v1/marketplace/participants",
        "required": ["tenant_id", "external_key", "display_name", "marketplace_sides", "contact"],
        "properties": {
          "party_id": { "type": ["string", "null"], "format": "uuid" },
          "tenant_id": { "type": "string", "format": "uuid" },
          "domain_id": { "type": ["string", "null"], "format": "uuid" },
          "platform_path": { "type": "string" },
          "external_key": { "type": "string", "minLength": 1, "maxLength": 256 },
          "display_name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "marketplace_sides": { "type": "array", "items": { "enum": ["demand", "supply"] }, "minItems": 1, "maxItems": 2, "uniqueItems": true },
          "contact": { "type": "object" }
        }
      }
    },
    "intent": {
      "create": {
        "method": "POST",
        "path": "/v1/marketplace/intents",
        "required": ["tenant_id", "domain_id", "participant_id", "side", "narrative", "idempotency_key"],
        "properties": {
          "intent_id": { "type": "string", "format": "uuid" },
          "tenant_id": { "type": "string", "format": "uuid" },
          "domain_id": { "type": "string", "format": "uuid" },
          "participant_id": { "type": "string", "format": "uuid" },
          "side": { "enum": ["demand", "supply"] },
          "narrative": { "type": "string", "minLength": 1, "maxLength": 10000 },
          "attributes": { "type": "object" },
          "terms": { "type": "object" },
          "supply_discovery_enabled": { "type": "boolean", "default": false, "description": "Explicitly allow a contact-free demand summary to be ranked by supply-side Agents." },
          "supply_discovery_expires_at": { "type": ["string", "null"], "format": "date-time" },
          "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 240 },
          "expires_at": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "read": { "method": "GET", "path": "/v1/marketplace/intents/{intent_id}" },
      "discoveryUpdate": {
        "method": "PATCH",
        "path": "/v1/marketplace/intents/{intent_id}/discovery",
        "required": ["tenant_id", "domain_id", "participant_id", "enabled"],
        "description": "Owner-only enable/revoke for contact-free supply discovery. Revoking never revokes an already consented contact exchange."
      }
    },
    "offer": {
      "create": {
        "method": "POST",
        "path": "/v1/marketplace/offers",
        "required": ["tenant_id", "domain_id", "supply_party_id", "external_key", "display_name"],
        "properties": {
          "offer_id": { "type": "string", "format": "uuid" },
          "tenant_id": { "type": "string", "format": "uuid" },
          "domain_id": { "type": "string", "format": "uuid" },
          "supply_party_id": { "type": "string", "format": "uuid" },
          "asset_id": { "type": ["string", "null"], "format": "uuid" },
          "external_key": { "type": "string", "minLength": 1, "maxLength": 256 },
          "display_name": { "type": "string", "minLength": 1, "maxLength": 500 },
          "attributes": { "type": "object" },
          "terms": { "type": "object" },
          "expires_at": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "match": { "method": "POST", "path": "/v1/marketplace/intents/{intent_id}/matches" },
      "demandMatch": { "method": "POST", "path": "/v1/marketplace/offers/{offer_id}/demand-matches", "description": "Supply-side ranking of explicitly discoverable demand summaries; participant IDs and contacts are omitted." },
      "activate": { "method": "POST", "path": "/v1/admin/marketplace/offers/{offer_id}/activate" }
    },
    "introduction": {
      "create": {
        "method": "POST",
        "path": "/v1/marketplace/introductions",
        "required": ["tenant_id", "domain_id", "intent_id", "offer_id", "participant_id", "score", "idempotency_key", "expires_at"],
        "properties": {
          "introduction_id": { "type": "string", "format": "uuid" },
          "tenant_id": { "type": "string", "format": "uuid" },
          "domain_id": { "type": "string", "format": "uuid" },
          "intent_id": { "type": "string", "format": "uuid" },
          "offer_id": { "type": "string", "format": "uuid" },
          "participant_id": { "type": "string", "format": "uuid" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "reasons": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 32 },
          "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 240 },
          "expires_at": { "type": "string", "format": "date-time" }
        },
        "contactRelease": "separate supply-consent transition; this command never returns contact values"
      },
      "list": { "method": "GET", "path": "/v1/marketplace/introductions" },
      "contactRequest": {
        "method": "POST",
        "path": "/v1/marketplace/introductions/{introduction_id}/contact/request",
        "required": ["tenant_id", "domain_id", "participant_id", "idempotency_key"],
        "properties": { "tenant_id": { "type": "string", "format": "uuid" }, "domain_id": { "type": "string", "format": "uuid" }, "participant_id": { "type": "string", "format": "uuid" }, "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 240 } }
      },
      "contactConsent": {
        "method": "POST",
        "path": "/v1/marketplace/introductions/{introduction_id}/contact/consent",
        "required": ["tenant_id", "domain_id", "participant_id", "idempotency_key"],
        "properties": { "tenant_id": { "type": "string", "format": "uuid" }, "domain_id": { "type": "string", "format": "uuid" }, "participant_id": { "type": "string", "format": "uuid" }, "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 240 } }
      },
      "contactRelease": {
        "method": "POST",
        "path": "/v1/marketplace/introductions/{introduction_id}/contact",
        "required": ["tenant_id", "domain_id", "participant_id", "idempotency_key"],
        "properties": { "tenant_id": { "type": "string", "format": "uuid" }, "domain_id": { "type": "string", "format": "uuid" }, "participant_id": { "type": "string", "format": "uuid" }, "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 240 } },
        "returns": "counterpart contact only after supply consent"
      }
    }
  },
  "invariants": [
    "Every write is tenant-scoped and domain-scoped; the short-lived marketplace party capability is exchanged for one exact mounted platform path before the request is sent.",
    "Demand and supply capabilities are kernel sides; buyer/seller terminology remains a vertical adapter concern.",
    "Caller IDs and idempotency keys are replay-safe; a changed payload returns a conflict.",
    "Agent scores and reasons are advisory and cannot grant contact, payment, or transaction authority.",
    "Supply discovery is opt-in per demand intent and returns an anonymous summary only; contact still requires the demand introduction and supply consent transitions.",
    "A vertical may implement retrieval with its own MCP/Skill and any vector database, or use the deterministic fallback."
  ],
  "mcpTools": [
    "marketplace.intent.create",
    "marketplace.offer.create",
    "marketplace.offer.match",
    "marketplace.demand.match",
    "marketplace.intent.discovery.update",
    "marketplace.introduction.create",
    "marketplace.introductions.list",
    "marketplace.introduction.contact.request",
    "marketplace.introduction.contact.consent",
    "marketplace.introduction.contact.release"
  ]
}
