{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matchplane.dev/schemas/catalog/v1.json",
  "title": "MatchPlane child catalog upsert ABI v1",
  "description": "The root sends a canonical, opaque offer projection to a child-owned catalog adapter. The child owns indexing and ranking; the root owns publication state and scope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "request_id", "scope", "offer"],
  "properties": {
    "protocol": { "const": "matchplane.catalog/v1" },
    "request_id": { "type": "string", "format": "uuid" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "domain_id", "platform_path"],
      "properties": {
        "tenant_id": { "type": "string", "format": "uuid" },
        "domain_id": { "type": "string", "format": "uuid" },
        "platform_path": { "type": "string", "pattern": "^/(?:[a-z0-9-]+(?:/[a-z0-9-]+)*)$", "maxLength": 512 }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offer_id", "external_key", "display_name", "attributes", "terms", "status"],
      "properties": {
        "offer_id": { "type": "string", "format": "uuid" },
        "external_key": { "type": "string", "minLength": 1, "maxLength": 256 },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "attributes": { "type": "object", "maxProperties": 256 },
        "terms": { "type": "object", "maxProperties": 256 },
        "status": { "enum": ["draft", "active", "reserved", "sold", "withdrawn", "expired"] },
        "attachments": { "type": "array", "maxItems": 64, "items": { "type": "string", "pattern": "^media://" } }
      }
    }
  }
}
