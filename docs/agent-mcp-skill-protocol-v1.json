{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matchplane.dev/schemas/agent-mcp-skill-protocol-v1.json",
  "title": "MatchPlane Agent + Skill + MCP protocol v1",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/result" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "stage": {
      "type": "string",
      "enum": ["platform", "merchant", "inventory"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_path"],
      "properties": {
        "platform_path": {
          "type": "string",
          "pattern": "^/(?:[a-z0-9-]+(?:/[a-z0-9-]+)*)?$",
          "maxLength": 512
        },
        "tenant_id": { "type": ["string", "null"], "format": "uuid" },
        "domain_id": { "type": ["string", "null"], "format": "uuid" }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narrative", "requirements"],
      "properties": {
        "narrative": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "requirements": { "type": "object" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_steps", "max_input_characters", "max_output_tokens", "cost_bearer"],
      "properties": {
        "max_steps": { "type": "integer", "minimum": 1, "maximum": 16 },
        "max_input_characters": { "type": "integer", "minimum": 1, "maximum": 24000 },
        "max_output_tokens": { "type": "integer", "minimum": 64, "maximum": 2048 },
        "cost_bearer": { "enum": ["platform", "caller"] }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "request_id", "stage", "scope", "intent", "skill", "allowed_mcp_tools", "budget"],
      "properties": {
        "protocol": { "const": "matchplane.agent/v1" },
        "request_id": { "$ref": "#/$defs/uuid" },
        "stage": { "$ref": "#/$defs/stage" },
        "scope": { "$ref": "#/$defs/scope" },
        "intent": { "$ref": "#/$defs/intent" },
        "skill": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$" },
        "allowed_mcp_tools": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$" }
        },
        "budget": { "$ref": "#/$defs/budget" },
        "trace_id": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "tool_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "tool", "status"],
      "properties": {
        "step": { "type": "integer", "minimum": 1, "maximum": 16 },
        "tool": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$" },
        "status": { "enum": ["completed", "skipped", "failed"] },
        "input_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "output_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "reason": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "request_id", "stage", "status", "steps", "selected", "provider", "budget", "degraded"],
      "properties": {
        "protocol": { "const": "matchplane.agent/v1" },
        "request_id": { "$ref": "#/$defs/uuid" },
        "stage": { "$ref": "#/$defs/stage" },
        "status": { "enum": ["completed", "degraded", "rejected"] },
        "steps": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/tool_step" }
        },
        "selected": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "score", "reasons"],
            "properties": {
              "ref": { "type": "string", "minLength": 1, "maxLength": 256 },
              "score": { "type": "number", "minimum": -1, "maximum": 1 },
              "reasons": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
            }
          }
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "maxLength": 128 },
            "version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "model": { "type": ["string", "null"], "maxLength": 200 },
            "prompt_tokens": { "type": ["integer", "null"], "minimum": 0 },
            "completion_tokens": { "type": ["integer", "null"], "minimum": 0 },
            "total_tokens": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "budget": { "$ref": "#/$defs/budget" },
        "degraded": { "type": "boolean" },
        "generated_at": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
