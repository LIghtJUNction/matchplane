{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "web": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "src/lib/platform-router-config/fixtures/transaction-child.ts",
        "public/**/*.js",
        "src/api.ts",
        "src/catalog-{projection,protocol}.ts",
        "src/federation-contract.ts",
        "src/lib/{auth,mail,payment-admin,preferences,root-email-config}.ts",
        "src/media-attachment.ts",
        "src/platform-agent-{handoff,session}.ts",
        "src/platform-router.ts",
        "src/retrieval-protocol.ts",
        "src/shopping-{intent,memory-contract}.ts",
        "src/store-finance.ts",
        "src/storefront-lifecycle.postgres.ts",
        "src/subplatform.ts",
        "src/types.ts"
      ]
    },
    "integrations/matchplane-agent-client": {
      "entry": [
        "examples/*.ts"
      ],
      "ignoreBinaries": [
        "tsc"
      ]
    }
  }
}
